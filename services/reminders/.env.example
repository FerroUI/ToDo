# Copy to .env; run `npm run keys` and insert its three generated values.
TODO_PUSH_ORIGINS=https://ferroui.com
TODO_PUSH_VAPID_SUBJECT=mailto:admin@example.org
TODO_PUSH_VAPID_PUBLIC_KEY=
TODO_PUSH_VAPID_PRIVATE_KEY=
TODO_PUSH_ENROLLMENT_KEY=
TODO_PUSH_HOST=127.0.0.1
TODO_PUSH_PORT=8787
TODO_PUSH_DATA_FILE=data/reminders.json
TODO_PUSH_MAX_INSTALLATIONS=1000
TODO_PUSH_MAX_JOBS=200
TODO_PUSH_HORIZON_DAYS=366
TODO_PUSH_LEASE_DAYS=366
TODO_PUSH_EXPIRY_MINUTES=60
# Optional exact provider hosts (comma separated), never wildcard domains:
TODO_PUSH_EXTRA_ENDPOINT_HOSTS=
# Development only: allow exact http://localhost or http://127.0.0.1 app origins.
TODO_PUSH_ALLOW_LOCAL_HTTP=0
